<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Info"
      internalLogFile=".\internal-nlog-AspNetCore.txt">

  <variable name="siteUrl" value="${aspnet-request-url:IncludePort=false}" />
  
  <!-- the targets to write to -->
  <targets>
    <!-- File Target for all log messages with basic details -->
    <target xsi:type="File" name="allfile"
            fileName="Logs/nlog-AspNetCore-all-${shortdate}.log"
            layout="${longdate}|${event-properties:item=EventId_Id:whenEmpty=0}|${uppercase:${level}}|${logger}|${message} ${exception:format=tostring}" />

    <!-- File Target for own log messages with extra web details using some ASP.NET core renderers -->
    <target xsi:type="File" name="ownFile-web" fileName="Logs/nlog-AspNetCore-own-${shortdate}.log"
            layout="${longdate}|${event-properties:item=EventId_Id:whenEmpty=0}|${uppercase:${level}}|${logger}|${message} ${exception:format=tostring}|url: ${aspnet-request-url}|action: ${aspnet-mvc-action}|${callsite}| body: ${aspnet-request-posted-body}" />

    <!--Console Target for hosting lifetime messages to improve Docker / Visual Studio startup detection -->
    <target xsi:type="Console" name="lifetimeConsole" layout="${level:truncate=4:lowercase=true}: ${logger}[0]${newline}      ${message}${exception:format=tostring}" />

    <target name="infofile"
            xsi:type="File"
            fileName="Logs/App-Information.log"
            archiveEvery="Day"
            archiveFileName="Logs/Archive/{#}_Information.log"
            archiveNumbering="DateAndSequence"
            maxArchiveFiles="30" />

    <target name="errorfile"
             xsi:type="File"
             fileName="Logs/App-Error.log"
             layout="${longdate} ${message} ${exception:format=tostring}"
             archiveEvery="Day"
             archiveFileName="Logs/Archive/{#}_Error.log"
             archiveNumbering="DateAndSequence"
             maxArchiveFiles="30" />

  </targets>

  <!-- rules to map from logger name to target -->
  <rules>
    <!--All logs, including from Microsoft-->
    <logger name="*" minlevel="Trace" writeTo="allfile" />
    
    <logger name="*" minlevel="Debug" writeTo="infofile" >
      <filters defaultAction='Log'>
        <when condition="contains('${message}','PerformanceInfo')" action="Ignore" />
      </filters>
    </logger>
    
    <logger name="*" minlevel="Warn" writeTo="errorfile" />
    
    <!--Output hosting lifetime messages to console target for faster startup detection -->
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="lifetimeConsole, ownFile-web" final="true" />
   

    <!--Skip non-critical Microsoft logs and so log only own logs (BlackHole) -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />
    <logger name="*" minlevel="Trace" writeTo="ownFile-web" />
    <logger name="*" minlevel="Debug" writeTo="logconsole" />

  </rules>
</nlog>
