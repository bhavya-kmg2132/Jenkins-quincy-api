{
  // THe routes for auth should be written on the top, because it is hosted differently
  // & path template : "/gateway/timesheet/{}", is common for Timesheet microservicews & 
  //Timesheet authentication microservices, causing authentication on get users from auth itself.


  //Gateways : 
  //1. Heartbeat
  "Routes": [
    {
      "UpstreamPathTemplate": "/gateway/heartbeat",
      "UpstreamHttpMethod": [ "POST", "PUT", "GET" ],
      "DownstreamPathTemplate": "/api/v1/heartbeat",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "10.1.29.32",
          "Port": 85
        }
      ]
    },
    //2. WeatherForecast
    {
      "DownstreamPathTemplate": "/WeatherForecast",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "10.1.29.32",
          "Port": 85
        }
      ],
      "UpstreamPathTemplate": "/gateway/WeatherForecast",
      "UpstreamHttpMethod": [ "GET" ]
    },

    //=============================   (NetCore)   ====================================
    // Auth routes — no authentication at gateway level

    {
      "UpstreamPathTemplate": "/api/v1/Auth/login",
      "UpstreamHttpMethod": [ "POST" ],
