	<sql name="PostgreNotification.GetRecentNotifications">
		<![CDATA[
       SELECT * FROM "InSystemNotification" WHERE "CreatedDateTime" >= (NOW() AT TIME ZONE 'UTC' - INTERVAL '48 hours');
		]]>
	</sql>

