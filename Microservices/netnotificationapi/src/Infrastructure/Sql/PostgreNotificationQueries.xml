	<sql name="PostgreNotification.MassTransitServiceLogs">
		<![CDATA[
          INSERT INTO "message_contract_store" (
        id,
        correlation_id,
        conversation_id,
        message_type,
        source_address,
        destination_address,
        payload
    )
    VALUES (
        @Id,
        @CorrelationId,
        @ConversationId,
        @MessageType,
        @SourceAddress,
        @DestinationAddress,
        @Payload::jsonb
    );

		]]>
	</sql>

