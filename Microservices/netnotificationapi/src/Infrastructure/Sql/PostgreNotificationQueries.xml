	<sql name="PostgreNotification.GetNotificationRequests">
		<![CDATA[
       SELECT 
         "Id",
         "ApiKey",
         "EmailFrom",
         "EmailTo",
         "EmailCc",
         "EmailBcc",
         "EmailSubject",
         "EmailBody",
         "NotificationErrorMessage",
         "ScheduledDateTime",
         "NotificationResponseDateTime",
         "EmailAttachments"::text AS "EmailAttachments",
         "EntityJson"::text AS "EntityJson",
         "NotificationDelivery"::text AS "NotificationDelivery",
		 "CreatedBy",
         "CreatedById",
         "CreatedDateTime",
         "UpdatedBy",
         "UpdatedById",
         "UpdatedDateTime",
         "UpdateReason",
         "OwnerId",
         "IsActive",
         "IsDeleted",
         "IsApproved",
         "ApproverId",
         "ApprovedDateTime",
         "IsAuthorized",
         "AuthorizedById",
         "AuthorizedDateTime",
         "SysData",
         "TenantId",
         "AssociatedUserId",
         "SubTenantId"
       FROM "NotificationRequest";
		]]>
	</sql> 

