      },
      {
        "RuleName": "HiredCarExcessPositiveClassCode",
        "SuccessEvent": "Hired Car class code is valid",
        "ErrorMessage": "Class Code must be 661100 when Excess Hired within Hired Car is greater than 0.",
        "ErrorType": "Error",
        "RuleExpressionType": "LambdaExpression",
        "Expression": "!input1.IsHiredCarEntry || !input1.HasValue(input1.ClassCode) || !input1.IsAbove(input1.ExcessHired, 0) || input1.Is(input1.ClassCode, \"661100\")"
      },
      {
        "RuleName": "NonOwnedAddlInsuredClassCode",
        "SuccessEvent": "Non-Owned class code is valid",
        "ErrorMessage": "Class Code must be 667100 when Employees as Additional Insured is Yes.",
        "ErrorType": "Error",
        "RuleExpressionType": "LambdaExpression",
        "Expression": "!input1.IsNonOwnedEntry || !input1.HasValue(input1.ClassCode) || !input1.IsYes(input1.EmployeesAsAdditionalInsured) || input1.Is(input1.ClassCode, \"667100\")"
      },
      {
        "RuleName": "NonOwnedEmployeeCountClassCode",
        "SuccessEvent": "Non-Owned class code is valid",
        "ErrorMessage": "Non-Owned Class Code must match the number of employees: 0-25 = 660100, 26-100 = 660200, 101-500 = 660300, 501-1000 = 660400, over 1000 = 660500.",
        "ErrorType": "Error",
        "RuleExpressionType": "LambdaExpression",
        "Expression": "!input1.IsNonOwnedEntry || !input1.HasValue(input1.ClassCode) || input1.IsYes(input1.EmployeesAsAdditionalInsured) || input1.NonOwnedEmployeeCount == null || (input1.InRange(input1.NonOwnedEmployeeCount, 0, 25) && input1.Is(input1.ClassCode, \"660100\")) || (input1.InRange(input1.NonOwnedEmployeeCount, 26, 100) && input1.Is(input1.ClassCode, \"660200\")) || (input1.InRange(input1.NonOwnedEmployeeCount, 101, 500) && input1.Is(input1.ClassCode, \"660300\")) || (input1.InRange(input1.NonOwnedEmployeeCount, 501, 1000) && input1.Is(input1.ClassCode, \"660400\")) || (input1.IsAbove(input1.NonOwnedEmployeeCount, 1000) && input1.Is(input1.ClassCode, \"660500\"))"
      }
