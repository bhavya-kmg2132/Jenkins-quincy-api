        "ErrorType": "Error",
        "RuleExpressionType": "LambdaExpression",
        "Expression": "!input1.HasValue(input1.PropertyDamage) || !input1.HasEffectiveDate || input1.IsEffectiveOnOrAfterJuly2025 || input1.In(input1.PropertyDamage, \"No Coverage|5,000|10,000|15,000|20,000|25,000|30,000|35,000|50,000|75,000|100,000|150,000|200,000|250,000|300,000|350,000|400,000|500,000|750,000|1,000,000\")"
      },
      {
        "RuleName": "PropertyDamageOptionsOnOrAfterJuly2025",
        "SuccessEvent": "Property Damage limit is valid",
        "ErrorMessage": "Property Damage is not a valid option for an Effective Date on or after 1 July 2025.",
        "ErrorType": "Error",
        "RuleExpressionType": "LambdaExpression",
        "Expression": "!input1.HasValue(input1.PropertyDamage) || !input1.HasEffectiveDate || !input1.IsEffectiveOnOrAfterJuly2025 || input1.In(input1.PropertyDamage, \"Included|30,000|35,000|50,000|75,000|100,000|150,000|200,000|250,000|300,000|350,000|400,000|500,000|750,000|1,000,000\")"
      },
      {
        "RuleName": "UninsuredOptionsBeforeJuly2025",
        "SuccessEvent": "Uninsured limit is valid",
        "ErrorMessage": "Uninsured is not a valid option for an Effective Date before 1 July 2025.",
        "ErrorType": "Error",
        "RuleExpressionType": "LambdaExpression",
        "Expression": "!input1.HasValue(input1.Uninsured) || !input1.HasEffectiveDate || input1.IsEffectiveOnOrAfterJuly2025 || input1.In(input1.Uninsured, \"No Coverage|20/40|20/50|25/50|25/65|30/60|35/70|35/80|50/100|50/200|100/200|100/300|100/500|250/500|300/500|500/500|500/1,000|1,000/1,000\")"
      },
      {
        "RuleName": "UninsuredOptionsOnOrAfterJuly2025",
        "SuccessEvent": "Uninsured limit is valid",
        "ErrorMessage": "Uninsured is not a valid option for an Effective Date on or after 1 July 2025.",
        "ErrorType": "Error",
        "RuleExpressionType": "LambdaExpression",
        "Expression": "!input1.HasValue(input1.Uninsured) || !input1.HasEffectiveDate || !input1.IsEffectiveOnOrAfterJuly2025 || input1.In(input1.Uninsured, \"No Coverage|25/50|25/65|30/60|35/70|35/80|40/90|50/100|50/200|100/200|100/300|100/500|250/500|300/500|500/500|500/1,000|1,000/1,000\")"
      },
      {
        "RuleName": "UnderinsuredOptionsBeforeJuly2025",
        "SuccessEvent": "Underinsured limit is valid",
        "ErrorMessage": "Underinsured is not a valid option for an Effective Date before 1 July 2025.",
        "ErrorType": "Error",
        "RuleExpressionType": "LambdaExpression",
        "Expression": "!input1.HasValue(input1.Underinsured) || !input1.HasEffectiveDate || input1.IsEffectiveOnOrAfterJuly2025 || input1.In(input1.Underinsured, \"No Coverage|20/40|20/50|25/50|25/65|30/60|35/70|35/80|50/100|50/200|100/200|100/300|100/500|250/500|500/500|500/1,000\")"
      },
      {
        "RuleName": "UnderinsuredOptionsOnOrAfterJuly2025",
        "SuccessEvent": "Underinsured limit is valid",
        "ErrorMessage": "Underinsured is not a valid option for an Effective Date on or after 1 July 2025.",
        "ErrorType": "Error",
        "RuleExpressionType": "LambdaExpression",
        "Expression": "!input1.HasValue(input1.Underinsured) || !input1.HasEffectiveDate || !input1.IsEffectiveOnOrAfterJuly2025 || input1.In(input1.Underinsured, \"No Coverage|25/50|25/65|30/60|35/70|35/80|50/100|50/200|100/200|100/300|100/500|250/500|500/500|500/1,000\")"
      },
      {
        "RuleName": "MedicalPaymentsOptions",
        "SuccessEvent": "Medical Payments limit is valid",
