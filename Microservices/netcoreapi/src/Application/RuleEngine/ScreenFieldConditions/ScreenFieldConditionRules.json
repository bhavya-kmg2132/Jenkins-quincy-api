        "Expression": "!input1.HasValue(input1.Collision) || input1.Is(input1.Collision, \"No Coverage\") || !input1.HasValue(input1.LimitedCollision) || input1.Is(input1.LimitedCollision, \"No Coverage\")"
      },
      {
        "RuleName": "HiredCarExcessBlankClassCode",
        "SuccessEvent": "Hired Car class code is valid",
